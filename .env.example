# Supabase Dashboard -> Project Settings -> Data API থেকে "Project URL" নিন।
#
# গুরুত্বপূর্ণ: শেষে /rest/v1 রাখবেন না। ড্যাশবোর্ডে REST endpoint হিসেবে
# https://<ref>.supabase.co/rest/v1/ দেখানো হয়, কিন্তু supabase-js নিজেই
# /rest/v1 জুড়ে নেয় — দুবার জুড়লে PostgREST "Invalid path specified in
# request URL" (PGRST125) ফেরায়।
#
#   ঠিক  : https://your-project.supabase.co
#   ভুল  : https://your-project.supabase.co/rest/v1/
VITE_SUPABASE_URL=https://your-project.supabase.co

# anon / publishable key (service_role বা secret key নয়)
VITE_SUPABASE_ANON_KEY=eyJ...
